<Page
    x:Class="XCleaner.Views.Pages.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XCleaner.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:XCleaner.Models"
    xmlns:helpers="clr-namespace:XCleaner.Helpers"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Title="CleanerPage"
    ScrollViewer.CanContentScroll="False"
    d:DataContext="{d:DesignInstance local:CleanerPage,IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Focusable="True"
    FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">

    <!-- <Page.InputBindings> -->
    <!--     <KeyBinding -->
    <!--         Key="F5" -->
    <!--         Command="{Binding ViewModel.ScanCommand}" /> -->
    <!-- </Page.InputBindings> -->

    <Page.Resources>
        <helpers:ByteSizeConverter x:Key="ByteSizeConverter" />
    </Page.Resources>

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <ComboBox
                HorizontalAlignment="Left"
                ItemsSource="{Binding ViewModel.CleanFolders}"
                SelectedItem="{Binding ViewModel.SelectedFolder}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding }" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ViewModel.ScanCommand, Mode=OneWay}"
                Content="立即扫描"
                Icon="Fluent24" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ViewModel.SortByNameCommand, Mode=OneWay}"
                Content="名称排序"
                Icon="Fluent24" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ViewModel.SortByModifiedCommand, Mode=OneWay}"
                Content="日期排序"
                Icon="Fluent24" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ViewModel.SortBySizeCommand, Mode=OneWay}"
                Content="大小排序"
                Icon="Fluent24" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ViewModel.ShowDialogCommand}"
                Content="批量删除"
                Background="LightCyan"
                Icon="Fluent24" />
        </StackPanel>

        <ui:ListView
            Name="MyListView"
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,12,0,0"
            d:ItemsSource="{d:SampleData ItemCount=2}"
            ItemsSource="{Binding ViewModel.Items, Mode=OneWay}">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="SelectionChanged">
                    <b:InvokeCommandAction
                        Command="{Binding ViewModel.SelectionChangedCommand}"
                        PassEventArgsToCommand="True" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <ui:ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:CleanItem}">
                    <Grid Margin="8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="*" MaxWidth="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:ImageIcon
                            x:Name="Icon"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            Width="32"
                            Height="32"
                            Margin="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="pack://application:,,,/Assets/folder-256.png" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="12,6,0,0"
                            FontWeight="Bold"
                            Text="{Binding Name, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="12,0,0,6"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Path, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding LatestFileModifiedTime, StringFormat={}{0:yyyy/MM/dd HH:mm}, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            Grid.RowSpan="2"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Size, Mode=OneWay,Converter={StaticResource ByteSizeConverter}}" />
                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="4"
                            Grid.RowSpan="2"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Checked, Mode=TwoWay}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Checked">
                                    <b:InvokeCommandAction
                                        Command="{Binding DataContext.ViewModel.CheckChangedCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding Checked}" />
                                </b:EventTrigger>
                                <b:EventTrigger EventName="Unchecked">
                                    <b:InvokeCommandAction
                                        Command="{Binding DataContext.ViewModel.CheckChangedCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding Checked}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </CheckBox>
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开目录" Command="{Binding ViewModel.ShowInExplorerCommand}"
                              CommandParameter="{Binding SelectedItem, ElementName=MyListView }" />
                </ContextMenu>
            </ListView.ContextMenu>
        </ui:ListView>
    </Grid>
</Page>